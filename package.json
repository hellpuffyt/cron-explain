{
  "name": "cron-explain",
  "version": "0.1.0",
  "description": "Parse a cron expression, explain it in prose, and preview the next runs in a chosen timezone including DST edges.",
  "keywords": [
    "cron",
    "crontab",
    "schedule",
    "timezone",
    "dst",
    "cli"
  ],
  "license": "MIT",
  "author": "Prabesh Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellpuffyt/cron-explain.git"
  },
  "homepage": "https://github.com/hellpuffyt/cron-explain#readme",
  "bugs": {
    "url": "https://github.com/hellpuffyt/cron-explain/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cron-explain": "bin/cron-explain.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^3.2.7"
  }
}
